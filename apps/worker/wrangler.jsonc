{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "agentpaint",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-17",
  // Invocation logs would record request URLs, and a painting's agent key is
  // part of its MCP URL; only explicit console logs (which never hold keys) are kept.
  "observability": { "enabled": true, "logs": { "enabled": true, "invocation_logs": false } },

  // Compile the Rust renderer to WASM before every build; `wrangler dev`
  // rebuilds when the renderer sources change.
  "build": {
    "command": "bun run build:wasm",
    "cwd": "../..",
    "watch_dir": "../../crates/renderer/src"
  },

  // Gallery, painting and series pages. The Worker runs first for the API, the
  // MCP endpoints and the per-painting and per-series page routes.
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/mcp", "/mcp/*", "/p/*", "/s/*", "/tests", "/tests/*"]
  },

  // Rendering a stroke is CPU-bound (tens of ms); give replays after an
  // eviction headroom beyond the 30 s default.
  "limits": { "cpu_ms": 120000 },

  "durable_objects": {
    "bindings": [
      { "name": "PAINTING", "class_name": "Painting" },
      { "name": "REGISTRY", "class_name": "Registry" }
    ]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Painting", "Registry"] }],

  "r2_buckets": [{ "binding": "SNAPSHOTS", "bucket_name": "agentpaint-snapshots" }],

  // MCP requests per pool agent, MCP requests per created painting, and
  // painting creations per client IP.
  "ratelimits": [
    { "name": "MCP_LIMITER", "namespace_id": "2001", "simple": { "limit": 120, "period": 60 } },
    { "name": "SCOPED_LIMITER", "namespace_id": "2003", "simple": { "limit": 120, "period": 60 } },
    { "name": "SCOPED_CLIENT_LIMITER", "namespace_id": "2007", "simple": { "limit": 120, "period": 60 } },
    { "name": "CREATE_LIMITER", "namespace_id": "2005", "simple": { "limit": 20, "period": 60 } }
  ],

  "vars": {
    "MAX_ACTIVE_PAINTINGS": "6",
    "MAX_CREATED_PAINTINGS": "100",
    "MAX_CREATED_PER_CLIENT": "30",
    "CANVAS_IDLE_SECONDS": "600",
    "CREATED_IDLE_SECONDS": "21600"
  },
  // MCP_TOKENS: comma-separated `name:token` pairs (tokens >= 32 chars). Locally, set it in .dev.vars;
  // in production `wrangler secret put MCP_TOKENS`; for previews
  // `wrangler preview base-config secret put MCP_TOKENS`.
  "secrets": { "required": ["MCP_TOKENS"] },

  // Worker Previews (one per branch, built by Workers Builds). Each Preview gets
  // its own Durable Objects automatically; snapshots go to a separate bucket.
  "previews": {
    "vars": {
      "MAX_ACTIVE_PAINTINGS": "3",
      "MAX_CREATED_PAINTINGS": "30",
      "MAX_CREATED_PER_CLIENT": "10",
      "CANVAS_IDLE_SECONDS": "600",
      "CREATED_IDLE_SECONDS": "21600"
    },
    "r2_buckets": [{ "binding": "SNAPSHOTS", "bucket_name": "agentpaint-snapshots-preview" }],
    "ratelimits": [
      { "name": "MCP_LIMITER", "namespace_id": "2002", "simple": { "limit": 120, "period": 60 } },
      { "name": "SCOPED_LIMITER", "namespace_id": "2004", "simple": { "limit": 120, "period": 60 } },
      { "name": "SCOPED_CLIENT_LIMITER", "namespace_id": "2008", "simple": { "limit": 120, "period": 60 } },
      { "name": "CREATE_LIMITER", "namespace_id": "2006", "simple": { "limit": 20, "period": 60 } }
    ]
  }
}
